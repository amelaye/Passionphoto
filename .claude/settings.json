{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make)",
      "Bash(make *)",
      "Bash(luajit *)",
      "Bash(luacheck *)",
      "Bash(./tools/*)",
      "Bash(tools/*)",
      "Bash(python3 -I tools/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Read(../Awards/**)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(pip *)",
      "Bash(python3 -m venv *)",
      "Bash(brew *)"
    ],
    "deny": [
      "Edit(./.deps/**)",
      "Write(./.deps/**)",
      "Edit(./.run/**)",
      "Write(./.run/**)",
      "Edit(./.headless/**)",
      "Write(./.headless/**)",
      "Edit(../Awards/**)",
      "Write(../Awards/**)",
      "Edit(../chester/**)",
      "Write(../chester/**)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ],
    "additionalDirectories": ["../Awards"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_edit.py\"",
            "timeout": 30,
            "statusMessage": "Contrôle du fichier modifié"
          }
        ]
      }
    ]
  }
}
